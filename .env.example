# Django
DJANGO_SECRET_KEY=django-insecure-bdo-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
DB_NAME=bdo_leads
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
USE_SQLITE=False

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend dev proxy target (used inside Docker network)
VITE_API_PROXY_TARGET=http://backend:8000

# Upwork API (used by job_refresh module)
UPWORK_CLIENT_KEY=your_upwork_client_key_here
UPWORK_CLIENT_SECRET=your_upwork_client_secret_here
UPWORK_ACCESS_TOKEN=your_upwork_oauth2_token_here
UPWORK_REFRESH_TOKEN=your_upwork_refresh_token_here
UPWORK_GRAPHQL_ENDPOINT=https://api.upwork.com/graphql

# Pinecone Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=bdo-faq-index

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
